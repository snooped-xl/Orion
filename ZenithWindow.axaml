<Window x:Class="OrbitAvalonia.ZenithWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1050" Height="650"
        MinWidth="760" MinHeight="500"
        Title="Zenith V2"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        FontFamily="avares://Orion/Assets/Zenith/Fonts#Nunito"
        CanResize="True">
  <Window.Resources>
    <SolidColorBrush x:Key="ZenithApp" Color="#0A0A0A" />
    <!-- Zenith's cards are deliberately translucent so page-level gradients remain visible. -->
    <SolidColorBrush x:Key="ZenithCard" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ZenithCardSoft" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ZenithButton" Color="#13FFFFFF" />
    <SolidColorBrush x:Key="ZenithButtonHover" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="ZenithBorder" Color="#3A3B3C" />
    <SolidColorBrush x:Key="ZenithBorderSoft" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ZenithPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ZenithSecondary" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="ZenithMuted" Color="#E69A9A9A" />
    <SolidColorBrush x:Key="ZenithInfo" Color="#39A2FF" />
    <SolidColorBrush x:Key="ZenithAccent" Color="#A473FF" />
    <LinearGradientBrush x:Key="ZenithSidebarGradient" StartPoint="50%,0%" EndPoint="50%,100%">
      <GradientStop Offset="0" Color="#3B82F6" />
      <GradientStop Offset="1" Color="#2563EB" />
    </LinearGradientBrush>
    <!-- Exact Fluent geometries embedded by the original Zenith title bar. -->
    <StreamGeometry x:Key="ZenithMinimizeGlyph">M4.250,12.000C4.250,11.586,4.586,11.250,5.000,11.250L19.000,11.250C19.414,11.250,19.750,11.586,19.750,12.000C19.750,12.414,19.414,12.750,19.000,12.750L5.000,12.750C4.586,12.750,4.250,12.414,4.250,12.000Z</StreamGeometry>
    <StreamGeometry x:Key="ZenithMaximizeGlyph">M16.500,6.000C16.500,4.343,15.157,3.000,13.500,3.000L6.000,3.000C4.343,3.000,3.000,4.343,3.000,6.000L3.000,13.500C3.000,15.157,4.343,16.500,6.000,16.500L6.000,10.500C6.000,8.015,8.015,6.000,10.500,6.000L16.500,6.000ZM18.000,7.500C19.657,7.500,21.000,8.843,21.000,10.500L21.000,18.000C21.000,19.657,19.657,21.000,18.000,21.000L10.500,21.000C8.843,21.000,7.500,19.657,7.500,18.000L7.500,10.500C7.500,8.843,8.843,7.500,10.500,7.500L18.000,7.500Z</StreamGeometry>
