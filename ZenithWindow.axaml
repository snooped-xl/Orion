  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontWeight" Value="Regular" />
    </Style>
    <Style Selector="Button">
      <!-- This is the Nunito variable face preserved from Zenith V2 itself. -->
      <Setter Property="FontFamily" Value="avares://Orion/Assets/Zenith/Fonts#Nunito" />
      <Setter Property="Foreground" Value="{StaticResource ZenithSecondary}" />
      <Setter Property="Background" Value="{StaticResource ZenithButton}" />
      <Setter Property="BorderBrush" Value="{StaticResource ZenithBorderSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{StaticResource ZenithButtonHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#7A7A7A" />
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chrome:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#0AFFFFFF" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="#137C8293" />
      <Setter Property="Foreground" Value="#E69A9A9A" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <!-- A dedicated rounded clipping shell is required here: the stock Fluent
           template clips effects to a rectangle even when CornerRadius is set. -->
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#207C8293" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.action:pressed">
      <Setter Property="Background" Value="#307C8293" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.action:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="#137C8293" />
      <Setter Property="Foreground" Value="#E69A9A9A" />
    </Style>
    <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.action-blob">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(0.9)" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.action:pointerover Border.action-blob">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Button.action:pressed Border.action-blob">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    <Style Selector="Button.zenith-tab-add">
      <Setter Property="Width" Value="50" />
      <Setter Property="MinWidth" Value="50" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="0,6,12,6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="#E69A9A9A" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.zenith-tab-add:pointerover">
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
    </Style>
    <Style Selector="Button.zenith-tab-add:pressed">
      <Setter Property="Background" Value="#29FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.zenith-tab-close">
      <Setter Property="Width" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E69A9A9A" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Regular" />
    </Style>
    <Style Selector="Button.zenith-tab-close:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FF3737" />
    </Style>
    <Style Selector="Button.zenith-tab-close:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FF5555" />
    </Style>
    <Style Selector="Button.zenith-file-row">
      <Setter Property="Height" Value="27" />
      <Setter Property="MinHeight" Value="27" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource ZenithSecondary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.zenith-file-row:pointerover">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.zenith-file-row:pointerover TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.zenith-file-row:pointerover Path">
      <Setter Property="Stroke" Value="#E6FFFFFF" />
    </Style>
    <Style Selector="Button.filter">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="Foreground" Value="#999999" />
    </Style>
    <Style Selector="Button.filter.active">
      <Setter Property="Background" Value="#39A2FF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBox.zenith-provider">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource ZenithBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource ZenithSecondary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.zenith-provider:pointerover">
      <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="ComboBox.zenith-provider ComboBoxItem">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="Background" Value="#121212" />
      <Setter Property="Foreground" Value="{StaticResource ZenithSecondary}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox.zenith-provider ComboBoxItem:pointerover">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ComboBox.zenith-provider ComboBoxItem:selected">
      <Setter Property="Background" Value="#2939A2FF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.setting-card">
      <Setter Property="MinHeight" Value="80" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.setting-card:pointerover">
      <Setter Property="Background" Value="#24FFFFFF" />
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="40,0,62,0" />
      <Setter Property="Background" Value="#08000000" />
      <Setter Property="Foreground" Value="{StaticResource ZenithSecondary}" />
      <Setter Property="Watermark" Value="Search..." />
      <Setter Property="BorderBrush" Value="{StaticResource ZenithBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource ZenithCard}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ToggleSwitch.zenith-toggle">
      <Setter Property="OnContent" Value="" />
      <Setter Property="OffContent" Value="" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </Window.Styles>

  <Border x:Name="ZenithChrome"
          Background="{StaticResource ZenithApp}"
          BorderBrush="{StaticResource ZenithBorder}"
          BorderThickness="1"
          CornerRadius="7"
          ClipToBounds="True">
    <Grid RowDefinitions="42,*">
      <!-- Original status field overflows the title bar and washes across the shell below it. -->
      <Border x:Name="BridgeStatusGlow" Grid.RowSpan="2" ZIndex="40" Width="600" Height="600"
              Margin="-293,-279,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
              CornerRadius="300" IsHitTestVisible="False">
        <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
        <Border.Background>
          <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%">
            <GradientStop Offset="0" Color="#664E4D72" />
            <GradientStop Offset="0.04" Color="#594E4D72" />
            <GradientStop Offset="0.10" Color="#404E4D72" />
            <GradientStop Offset="0.20" Color="#264E4D72" />
            <GradientStop Offset="0.33" Color="#144E4D72" />
            <GradientStop Offset="0.50" Color="#0A4E4D72" />
            <GradientStop Offset="1" Color="#004E4D72" />
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <!-- Original 42px Zenith title bar. -->
      <Border Grid.Row="0" ZIndex="50" Background="#08FFFFFF"
              BorderBrush="{StaticResource ZenithBorder}"
              BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="*,Auto,*">
          <StackPanel Grid.Column="0" ZIndex="1" Width="160" Margin="12,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="6">
            <Grid Width="14" Height="14" VerticalAlignment="Center">
              <Ellipse x:Name="BridgeStatusDotGlow" Width="14" Height="14" Fill="#4E4D72" Opacity="0.4">
                <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
              </Ellipse>
              <Ellipse x:Name="BridgeStatusDot" Width="14" Height="14" Fill="#4E4D72" />
            </Grid>
            <TextBlock x:Name="BridgeStatusText" Text="Inactive"
                       Foreground="#9A9A9A" FontWeight="Medium"
                       FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" ZIndex="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Zenith" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="V2" FontSize="18" FontWeight="SemiBold">
              <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Offset="0" Color="#667EEA" />
                  <GradientStop Offset="0.25" Color="#9C66FF" />
                  <GradientStop Offset="0.5" Color="#FF6B96" />
                  <GradientStop Offset="0.75" Color="#FFA87A" />
                  <GradientStop Offset="1" Color="#667EEA" />
                </LinearGradientBrush>
              </TextBlock.Foreground>
            </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" ZIndex="1" Margin="0,0,12,0" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Classes="chrome" Click="Minimize_Click" ToolTip.Tip="Minimize">
              <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithMinimizeGlyph}" /></Canvas></Viewbox>
            </Button>
            <Button Classes="chrome" Click="Maximize_Click" ToolTip.Tip="Maximize">
              <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithMaximizeGlyph}" /></Canvas></Viewbox>
            </Button>
            <Button Classes="chrome close" Width="26" Click="Close_Click" ToolTip.Tip="Close">
              <Viewbox Width="26" Height="26"><Canvas Width="26" Height="26"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithCloseGlyph}" /></Canvas></Viewbox>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
        <!-- Original nav is 56px collapsed and 200px on hover. -->
        <Border x:Name="NavigationPanel" Grid.Column="0" Width="56"
                Background="#08FFFFFF" BorderBrush="{StaticResource ZenithBorderSoft}"
                BorderThickness="0,0,1,0" ClipToBounds="True"
                PointerEntered="NavigationPanel_PointerEntered"
                PointerExited="NavigationPanel_PointerExited">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.30" Easing="CubicEaseOut" />
            </Transitions>
          </Border.Transitions>
          <Grid RowDefinitions="*,Auto" Margin="8">
            <StackPanel Grid.Row="0" Spacing="8">
              <Button x:Name="HomeNavButton" Classes="nav" Tag="Home" Click="NavButton_Click">
                <Grid ColumnDefinitions="40,*">
                  <Border x:Name="HomeNavIndicator" Grid.Column="0" Width="3" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ZenithSidebarGradient}" CornerRadius="20,0,0,20" />
                  <Viewbox Grid.Column="0" Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="#BF9A9A9A" Data="{StaticResource ZenithHomeGlyph}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Home" Foreground="#E69A9A9A" FontSize="16" FontWeight="Medium" LineHeight="19.2" VerticalAlignment="Center" Margin="4,0,12,0" />
                </Grid>
              </Button>
              <Button x:Name="ExecutionNavButton" Classes="nav" Tag="Execution" Click="NavButton_Click">
                <Grid ColumnDefinitions="40,*">
                  <Border x:Name="ExecutionNavIndicator" Grid.Column="0" Width="3" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ZenithSidebarGradient}" CornerRadius="20,0,0,20" Opacity="0" />
                  <Viewbox Grid.Column="0" Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="#BF9A9A9A" Data="{StaticResource ZenithExecutionGlyph}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Execution" Foreground="#E69A9A9A" FontSize="16" FontWeight="Medium" LineHeight="19.2" VerticalAlignment="Center" Margin="4,0,12,0" />
                </Grid>
              </Button>
              <Button x:Name="ScriptHubNavButton" Classes="nav" Tag="ScriptHub" Click="NavButton_Click">
                <Grid ColumnDefinitions="40,*">
                  <Border x:Name="ScriptHubNavIndicator" Grid.Column="0" Width="3" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ZenithSidebarGradient}" CornerRadius="20,0,0,20" Opacity="0" />
                  <Viewbox Grid.Column="0" Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="#BF9A9A9A" Data="{StaticResource ZenithScriptHubGlyph}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Script Hub" Foreground="#E69A9A9A" FontSize="16" FontWeight="Medium" LineHeight="19.2" VerticalAlignment="Center" Margin="4,0,12,0" />
                </Grid>
              </Button>
              <Button x:Name="DocumentationNavButton" Classes="nav" Tag="Documentation" Click="NavButton_Click">
                <Grid ColumnDefinitions="40,*">
                  <Border x:Name="DocumentationNavIndicator" Grid.Column="0" Width="3" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ZenithSidebarGradient}" CornerRadius="20,0,0,20" Opacity="0" />
                  <Viewbox Grid.Column="0" Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="#BF9A9A9A" Data="{StaticResource ZenithDocumentationGlyph}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Documentation" Foreground="#E69A9A9A" FontSize="16" FontWeight="Medium" LineHeight="19.2" VerticalAlignment="Center" Margin="4,0,12,0" />
                </Grid>
              </Button>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="8">
              <Button x:Name="HelpNavButton" Classes="nav" Tag="Help" Click="NavButton_Click">
                <Grid ColumnDefinitions="40,*">
                  <Border x:Name="HelpNavIndicator" Grid.Column="0" Width="3" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ZenithSidebarGradient}" CornerRadius="20,0,0,20" Opacity="0" />
                  <Viewbox Grid.Column="0" Width="24" Height="24">
                    <Canvas Width="24" Height="24">
                      <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                               Stroke="#BF9A9A9A" StrokeThickness="2" />
                      <Path Data="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"
                            Stroke="#BF9A9A9A" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                      <Path Data="M12 17L12.01 17"
                            Stroke="#BF9A9A9A" StrokeThickness="2" StrokeLineCap="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="Help" Foreground="#E69A9A9A" FontSize="16" FontWeight="Medium" LineHeight="19.2" VerticalAlignment="Center" Margin="4,0,12,0" />
                </Grid>
              </Button>
              <Button x:Name="SettingsNavButton" Classes="nav" Tag="Settings" Click="NavButton_Click">
                <Grid ColumnDefinitions="40,*">
                  <Border x:Name="SettingsNavIndicator" Grid.Column="0" Width="3" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ZenithSidebarGradient}" CornerRadius="20,0,0,20" Opacity="0" />
                  <Viewbox Grid.Column="0" Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="#BF9A9A9A" Data="{StaticResource ZenithSettingsGlyph}" /></Canvas></Viewbox>
                  <TextBlock Grid.Column="1" Text="Settings" Foreground="#E69A9A9A" FontSize="16" FontWeight="Medium" LineHeight="19.2" VerticalAlignment="Center" Margin="4,0,12,0" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="12">
          <!-- HOME -->
          <Grid x:Name="HomePage" RowDefinitions="73,12,*">
            <Border Grid.Row="0" Classes="card" ClipToBounds="True" Padding="12">
              <Grid>
                <Border Width="137" Height="139" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-62,0" Opacity="0.24"
                        RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><ScaleTransform ScaleX="2.1" ScaleY="2.1" /></Border.RenderTransform>
                  <Border.Effect><BlurEffect Radius="96" /></Border.Effect>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Offset="0" Color="#667EEA" />
                      <GradientStop Offset="1" Color="#764BA2" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Top" Spacing="8" Margin="0,-3,0,0">
                  <TextBlock Text="Hey there, orion!" FontSize="20" LineHeight="24" Foreground="White" />
                  <TextBlock FontSize="14" LineHeight="16.8" Foreground="{StaticResource ZenithMuted}">
                    <Run Text="Your license expires in 11 months and 30 days. You can " />
                    <Run Text="add time here." Foreground="#A473FF" />
                  </TextBlock>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
              <Border Grid.Column="0" Classes="card" Padding="12" ClipToBounds="True">
                <Grid>
                  <Border Width="137" Height="139" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-72,-30,0,0" Opacity="0.28"
                          RenderTransformOrigin="50%,50%">
                    <Border.RenderTransform><ScaleTransform ScaleX="2.1" ScaleY="2.1" /></Border.RenderTransform>
                    <Border.Effect><BlurEffect Radius="96" /></Border.Effect>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#F093FB" />
                        <GradientStop Offset="1" Color="#F5576C" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Margin="0,-3,0,0">
                    <TextBlock Text="Changelog" FontSize="20" LineHeight="24" FontWeight="SemiBold" Foreground="{StaticResource ZenithSecondary}" />
                    <TextBlock Text="Below you can find a changelog for the last few updates." FontSize="14" LineHeight="16.8" Foreground="{StaticResource ZenithMuted}" />
                    <TextBlock Text="You're all caught up! 🎊" Margin="0,25,0,0" HorizontalAlignment="Center" FontSize="14" LineHeight="16.8" Foreground="{StaticResource ZenithMuted}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="card" Padding="12" ClipToBounds="True">
                <Grid>
                  <Border Width="137" Height="139" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-72,0,0,-69" Opacity="0.22"
                          RenderTransformOrigin="50%,50%">
                    <Border.RenderTransform><ScaleTransform ScaleX="2.1" ScaleY="2.1" /></Border.RenderTransform>
                    <Border.Effect><BlurEffect Radius="96" /></Border.Effect>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#4FACFE" />
                        <GradientStop Offset="1" Color="#00F2FE" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Margin="0,-3,0,0">
                    <TextBlock Text="News" FontSize="20" LineHeight="24" FontWeight="SemiBold" Foreground="{StaticResource ZenithSecondary}" />
                    <TextBlock Text="Right now, there's no news to be seen. Come back later." FontSize="14" LineHeight="16.8" FontWeight="Medium" Foreground="{StaticResource ZenithSecondary}" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- Source-faithful Zenith execution editor. -->
          <!--
          <Grid x:Name="ExecutionPage" IsVisible="False" RowDefinitions="47,*,8,109,8,38">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="#08000000">
              <StackPanel x:Name="ZenithTabBar" Orientation="Horizontal" Spacing="6" Margin="12,0" />
              <Button Grid.Column="1" Width="50" Height="34" Margin="0,6,12,6" Padding="0" Click="NewTab_Click" Content="+" FontSize="18" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,8,200">
              <Border Grid.Column="0" Background="#141414" CornerRadius="12" ClipToBounds="True">
                <Grid>
                  <NativeWebView x:Name="ZenithEditorWebView" Background="#141414" />
                  <TextBlock Text="Ctrl+S save · Ctrl+W close · Ctrl+P commands · learn more →"
                             FontSize="12" FontStyle="Italic" Foreground="#6B9A9A9A"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"
                             IsHitTestVisible="False" />
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="card" ClipToBounds="True">
                <Grid RowDefinitions="36,*">
                  <Grid Margin="12,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="File List" FontSize="14" Foreground="#C49A9A9A" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="chrome" Width="26" Height="30" Click="ToggleFileList_Click" Content="▶" FontSize="11" />
                  </Grid>
                  <StackPanel Grid.Row="1" x:Name="ZenithFileList" Margin="10,2" Spacing="4" />
                </Grid>
              </Border>
            </Grid>
            <Border Grid.Row="3" Classes="card" ClipToBounds="True">
              <Grid RowDefinitions="34,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="12,0">
                  <TextBlock Text="Script Output" FontSize="14" Foreground="#C49A9A9A" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="chrome" Width="50" Height="32" Click="ClearOutput_Click" Content="Clear" FontSize="13" />
                  <Button Grid.Column="2" Classes="chrome" Width="24" Height="32" Click="ToggleOutput_Click" Content="▼" FontSize="11" />
                </Grid>
                <SelectableTextBlock x:Name="ZenithOutputText" Grid.Row="1" Margin="12,3" FontSize="12"
                                     FontStyle="Italic" Foreground="#737C8293"
                                     Text="Output from printconsole() → will appear here. Enable Error Spoofing → for errors too." TextWrapping="Wrap" />
              </Grid>
            </Border>
            <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
              <Button x:Name="ZenithAttachButton" Grid.Column="0" Classes="action" Click="Attach_Click" Content="▣  Attach" Margin="0,0,7,0" />
              <Button x:Name="ZenithExecuteButton" Grid.Column="1" Classes="action" Click="Execute_Click" Content="▶  Execute" />
              <Button Grid.Column="3" Classes="action" Click="OpenFile_Click" Content="▰  Open File" Margin="0,0,7,0" />
              <Button Grid.Column="4" Classes="action" Click="SaveFile_Click" Content="▣  Save File" Margin="0,0,7,0" />
              <Button Grid.Column="5" Classes="action" Click="ClearEditor_Click" Content="▰  Clear" />
            </Grid>
          </Grid>

          -->
          <Grid x:Name="ExecutionPage" IsVisible="False" RowDefinitions="46,8,*,8,36">
            <Border Grid.Row="0" Background="{StaticResource ZenithCard}" CornerRadius="12" ClipToBounds="True">
              <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="ZenithTabBar" Orientation="Horizontal" Spacing="4" Margin="12,0,4,0" />
                </ScrollViewer>
                <Button Grid.Column="1" Classes="zenith-tab-add" Click="NewTab_Click" Content="+" />
              </Grid>
            </Border>

            <Grid x:Name="ZenithEditorSplit" Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <Grid x:Name="ZenithEditorStack" Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="8" />
                  <RowDefinition Height="140" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#0D0D0D" CornerRadius="12" ClipToBounds="True" Padding="4">
                  <Grid ClipToBounds="True">
                    <NativeWebView x:Name="ZenithEditorWebView" Background="Transparent" />
                  </Grid>
                </Border>
                <Border x:Name="ZenithOutputPanel" Grid.Row="2" Background="{StaticResource ZenithCard}" CornerRadius="8" ClipToBounds="True">
                  <Grid RowDefinitions="32,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,52,32" Margin="12,0,4,0">
                      <TextBlock Text="Script Output" FontSize="14" FontWeight="Medium" Foreground="#E69A9A9A" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="chrome" Width="52" Height="32" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" Click="ClearOutput_Click" Content="Clear" FontSize="14" />
                      <Button Grid.Column="2" Classes="chrome" Width="32" Height="32" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Center" Click="ToggleOutput_Click">
                        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path x:Name="ZenithOutputChevron" Stroke="#BF9A9A9A" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithChevronDownGlyph}" /></Canvas></Viewbox>
                      </Button>
                    </Grid>
                    <ScrollViewer x:Name="ZenithOutputScroll" Grid.Row="1" Padding="12,6"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <SelectableTextBlock x:Name="ZenithOutputText" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           LineHeight="15" Foreground="#C5C5C5" TextWrapping="Wrap"
                                           SelectionBrush="#0E639C" SelectionForegroundBrush="White">
                        <SelectableTextBlock.Inlines>
                          <Run Text="Output from printconsole() → will appear here. Enable Error Spoofing → for errors too."
                               FontStyle="Italic" Foreground="#807C8293" />
                        </SelectableTextBlock.Inlines>
                      </SelectableTextBlock>
                    </ScrollViewer>
                    <Border x:Name="ZenithOutputResizeGrip" Grid.RowSpan="2" Height="5" VerticalAlignment="Top"
                            Background="Transparent" Cursor="SizeNorthSouth" ZIndex="5"
                            PointerPressed="OutputResizeGrip_PointerPressed"
                            PointerMoved="OutputResizeGrip_PointerMoved"
                            PointerReleased="OutputResizeGrip_PointerReleased" />
                  </Grid>
                </Border>
              </Grid>

              <Border x:Name="ZenithFileListPanel" Grid.Column="2" Background="{StaticResource ZenithCard}" CornerRadius="8" ClipToBounds="True">
                <Grid RowDefinitions="32,*">
                  <Grid Margin="12,0" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="ZenithFileListTitle" Text="File List" FontSize="14" FontWeight="Medium" Foreground="#E69A9A9A" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="chrome" Width="32" Height="32" HorizontalContentAlignment="Center" Click="ToggleFileList_Click">
                      <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path x:Name="ZenithFileListChevron" Fill="#E69A9A9A" Data="{StaticResource ZenithPanelTriangleGlyph}" RenderTransformOrigin="50%,50%" /></Canvas></Viewbox>
                    </Button>
                  </Grid>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ZenithFileList" Margin="4,8,12,12" Spacing="4" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

            <Grid Grid.Row="4" ColumnDefinitions="Auto,8,Auto,*,Auto,8,Auto,8,Auto">
              <Button x:Name="ZenithAttachButton" Grid.Column="0" Classes="action" Width="92" Click="Attach_Click">
                <Grid>
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="ZenithAttachBlob" Canvas.Left="-12" Canvas.Top="17" Classes="action-blob" Width="46" Height="36" CornerRadius="23">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#667EEA" />
                          <GradientStop Offset="1" Color="#764BA2" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                    </Border>
                  </Canvas>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="6" ZIndex="1">
                    <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithAttachGlyph}" /></Canvas></Viewbox>
                    <TextBlock x:Name="ZenithAttachLabel" Text="Attach" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="ZenithExecuteButton" Grid.Column="2" Classes="action" Width="98" Click="Execute_Click">
                <Grid>
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="ZenithExecuteBlob" Canvas.Left="58" Canvas.Top="-3" Classes="action-blob" Width="46" Height="36" CornerRadius="23">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#4FACFE" />
                          <GradientStop Offset="1" Color="#00F2FE" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                    </Border>
                  </Canvas>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="6" ZIndex="1">
                    <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithExecuteGlyph}" /></Canvas></Viewbox>
                    <TextBlock Text="Execute" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="ZenithOpenButton" Grid.Column="4" Classes="action" Width="115" Click="OpenFile_Click">
                <Grid>
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="ZenithOpenBlob" Canvas.Left="75" Canvas.Top="15" Classes="action-blob" Width="46" Height="36" CornerRadius="23">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                          <GradientStop Offset="0" Color="#F093FB" />
                          <GradientStop Offset="1" Color="#F5576C" />
                        </LinearGradientBrush>
                      </Border.Background>
                      <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                    </Border>
                  </Canvas>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="6" ZIndex="1">
                    <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithOpenGlyph}" /></Canvas></Viewbox>
                    <TextBlock Text="Open File" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="ZenithSaveButton" Grid.Column="6" Classes="action" Width="108" Click="SaveFile_Click">
                <Grid>
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="ZenithSaveBlob" Canvas.Left="-2" Canvas.Top="15" Classes="action-blob" Width="46" Height="36" CornerRadius="23"
                            Background="#2CFF35">
                      <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                    </Border>
                  </Canvas>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="6" ZIndex="1">
                    <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithSaveGlyph}" /></Canvas></Viewbox>
                    <TextBlock Text="Save File" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button x:Name="ZenithClearButton" Grid.Column="8" Classes="action" Width="80" Click="ClearEditor_Click">
                <Grid>
                  <Canvas IsHitTestVisible="False">
                    <Border x:Name="ZenithClearBlob" Canvas.Left="48" Canvas.Top="-3" Classes="action-blob" Width="46" Height="36" CornerRadius="23"
                            Background="#FF3737">
                      <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                    </Border>
                  </Canvas>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="6" ZIndex="1">
                    <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource ZenithClearGlyph}" /></Canvas></Viewbox>
                    <TextBlock Text="Clear" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </StackPanel>
                </Grid>
              </Button>
            </Grid>
          </Grid>

          <!-- SCRIPT HUB -->
          <Grid x:Name="ScriptHubPage" IsVisible="False" RowDefinitions="73,12,40,12,*">
            <Border Grid.Row="0" Classes="card" Padding="12" ClipToBounds="False">
              <Grid>
                <Border Width="137" Height="139" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-30,-30,0" CornerRadius="68.5" Background="#39A2FF" Opacity="0.25"
                        IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><ScaleTransform ScaleX="2.1" ScaleY="2.1" /></Border.RenderTransform>
                  <Border.Effect><BlurEffect Radius="96" /></Border.Effect>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4" ZIndex="1">
                  <TextBlock Text="Script Hub" FontSize="20" LineHeight="24" Foreground="White" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Discover and run scripts from " FontSize="14" Foreground="{StaticResource ZenithMuted}" />
                    <TextBlock x:Name="ZenithHubSourceHeader" Text="robloxscripts.com" FontSize="14"
                               Foreground="{StaticResource ZenithSecondary}" />
                    <Viewbox Width="10" Height="10" VerticalAlignment="Center" Opacity="0.7">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="{StaticResource ZenithSecondary}" StrokeThickness="2" StrokeLineCap="Round"
                              StrokeJoin="Round" Data="{StaticResource ZenithHubExternalGlyph}" />
                      </Canvas>
                    </Viewbox>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="12,0" ColumnDefinitions="*,12,174,8,Auto">
              <Grid Grid.Column="0">
                <TextBox x:Name="ZenithHubSearchBox" Classes="search" PlaceholderText="Search for scripts..."
                         TextChanged="ZenithHubSearchBox_TextChanged" />
                <Viewbox Width="17" Height="17" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24"><Path Stroke="#939393" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithSearchGlyph}" /></Canvas>
                </Viewbox>
                <Border HorizontalAlignment="Right" Margin="0,0,12,0" Padding="6,2" BorderBrush="#363636" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                  <TextBlock Text="Ctrl+K" FontSize="10" FontFamily="Consolas" Foreground="#777" />
                </Border>
              </Grid>
              <ComboBox x:Name="ZenithHubProviderBox" Grid.Column="2" Classes="zenith-provider"
                        SelectionChanged="ZenithHubProviderBox_SelectionChanged">
                <ComboBoxItem Content="robloxscripts.com" Tag="RobloxScripts" />
                <ComboBoxItem Content="rscripts" Tag="Rscripts" />
                <ComboBoxItem Content="haxhell" Tag="HaxHell" />
                <ComboBoxItem Tag="ScriptBlox">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="ScriptBlox" VerticalAlignment="Center" />
                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Path Stroke="#FF7940" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="{StaticResource ZenithHubWarningGlyph}" />
                      </Canvas>
                    </Viewbox>
                  </StackPanel>
                </ComboBoxItem>
              </ComboBox>
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button x:Name="ZenithHubRecentButton" Classes="filter active" Content="Recent" Tag="recent" Click="ZenithHubFilter_Click" />
                <Button x:Name="ZenithHubPopularButton" Classes="filter" Content="Popular" Tag="popular" Click="ZenithHubFilter_Click" />
                <Button x:Name="ZenithHubUniversalButton" Classes="filter" Content="Universal" Tag="universal" Click="ZenithHubFilter_Click" />
              </StackPanel>
            </Grid>
            <Grid x:Name="ZenithHubContent" Grid.Row="4" ClipToBounds="True">
              <ScrollViewer x:Name="ZenithHubScrollViewer" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" ScrollChanged="ZenithHubScrollViewer_ScrollChanged">
                <StackPanel x:Name="ZenithHubCardsPanel" Margin="0,1,0,16" Spacing="16" />
              </ScrollViewer>
              <StackPanel x:Name="ZenithHubStatePanel" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Margin="0,64,0,0" Spacing="0" MaxWidth="384">
                <Viewbox Width="48" Height="48" Margin="0,0,0,16">
                  <Canvas Width="24" Height="24"><Path Stroke="#809A9A9A" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithSearchGlyph}" /></Canvas>
                </Viewbox>
                <TextBlock x:Name="ZenithHubStateTitle" Text="Loading scripts..." HorizontalAlignment="Center"
                           Foreground="{StaticResource ZenithSecondary}" FontSize="18" FontWeight="Medium" Margin="0,0,0,4" />
                <TextBlock x:Name="ZenithHubStateDescription" HorizontalAlignment="Center"
                           Foreground="{StaticResource ZenithMuted}" FontSize="14" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button x:Name="ZenithHubClearSearchButton" Content="Clear search" IsVisible="False"
                          Click="ZenithHubClearSearch_Click" />
                  <Button x:Name="ZenithHubBrowsePopularButton" Content="Browse popular" IsVisible="False"
                          Click="ZenithHubBrowsePopular_Click" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- DOCUMENTATION -->
          <Grid x:Name="DocumentationPage" IsVisible="False" RowDefinitions="73,12,*">
            <Border Grid.Row="0" Classes="card" Padding="12" ClipToBounds="False">
              <Grid>
                <Border Width="137" Height="139" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-30,-30,0" CornerRadius="68.5" Background="#39A2FF" Opacity="0.25"
                        IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><ScaleTransform ScaleX="2.1" ScaleY="2.1" /></Border.RenderTransform>
                  <Border.Effect><BlurEffect Radius="96" /></Border.Effect>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4" ZIndex="1">
                  <TextBlock Text="Function Documentation" FontSize="20" Foreground="White" />
                  <TextBlock Text="Browse and search Zenith's custom Lua functions and API" FontSize="14" Foreground="{StaticResource ZenithMuted}" />
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="224,12,*">
              <Border Grid.Column="0" Classes="card" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="DocumentationCategoryPanel" Spacing="8" />
                </ScrollViewer>
              </Border>
              <Border Grid.Column="2" Classes="card">
                <Grid RowDefinitions="Auto,*">
                  <Border x:Name="DocumentationSearchShell" Grid.Row="0" Padding="12"
                          BorderBrush="{StaticResource ZenithBorderSoft}" BorderThickness="0,0,0,1">
                    <Grid>
                      <TextBox x:Name="DocumentationSearchBox" Classes="search" Height="36"
                                Padding="36,0,12,0" PlaceholderText="Search functions..." />
                      <Viewbox Width="16" Height="16" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24"><Path Stroke="#929292" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithSearchGlyph}" /></Canvas>
                      </Viewbox>
                    </Grid>
                  </Border>
                  <ScrollViewer x:Name="DocumentationContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DocumentationContentPanel" Margin="32" Spacing="16"
                                MaxWidth="896" HorizontalAlignment="Left" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- HELP -->
          <Grid x:Name="HelpPage" IsVisible="False" RowDefinitions="73,12,*">
            <Border Grid.Row="0" Classes="card" Padding="12" ClipToBounds="False">
              <Grid>
                <Border Width="137" Height="139" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-30,-30,0" CornerRadius="68.5" Background="#39A2FF" Opacity="0.25"
                        IsHitTestVisible="False" RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><ScaleTransform ScaleX="2.1" ScaleY="2.1" /></Border.RenderTransform>
                  <Border.Effect><BlurEffect Radius="96" /></Border.Effect>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4" ZIndex="1">
                  <TextBlock Text="Help &amp; Guides" FontSize="20" Foreground="White" />
                  <TextBlock Text="Learn how to use Zenith with comprehensive guides and tutorials" FontSize="14" Foreground="{StaticResource ZenithMuted}" />
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="256,12,*">
              <Border Grid.Column="0" Classes="card" Padding="12">
                <Grid RowDefinitions="36,12,*">
                  <Grid>
                    <TextBox x:Name="HelpSearchBox" Classes="search" Height="36" Padding="36,0,12,0" PlaceholderText="Search articles..." />
                    <Viewbox Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24"><Path Stroke="#929292" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithSearchGlyph}" /></Canvas>
                    </Viewbox>
                  </Grid>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HelpNavigationPanel" Spacing="8" />
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Column="2" Classes="card">
                <ScrollViewer x:Name="HelpContentScroll" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="HelpContentPanel" Margin="32" Spacing="17"
                              MaxWidth="896" HorizontalAlignment="Left" />
                </ScrollViewer>
              </Border>
            </Grid>
          </Grid>

          <!-- SETTINGS -->
          <Grid x:Name="SettingsPage" IsVisible="False">
            <Grid x:Name="SettingsMainPage" RowDefinitions="78,40,12,*">
              <StackPanel Grid.Row="0" Margin="4,7,0,0" Spacing="6">
                <TextBlock Text="Settings" FontSize="25" Foreground="White" />
                <TextBlock Text="Configure Zeniths execution and appearance  (Help?)" FontSize="14" Foreground="{StaticResource ZenithMuted}" />
              </StackPanel>
              <Grid Grid.Row="1">
                <TextBox Classes="search" PlaceholderText="Search all settings..." />
                <Viewbox Width="18" Height="18" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24"><Path Stroke="#929292" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithSearchGlyph}" /></Canvas>
                </Viewbox>
                <Border HorizontalAlignment="Right" Margin="0,0,12,0" Padding="6,2" BorderBrush="#363636" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center"><TextBlock Text="Ctrl+K" FontSize="10" FontFamily="Consolas" Foreground="#777"/></Border>
              </Grid>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="0,0,8,0">
                  <Button Classes="setting-card" Tag="Execution Settings" Click="SettingsSection_Click">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Execution Settings" FontSize="16" Foreground="White"/><TextBlock Text="Configure how scripts are executed and your preferences" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="28" Foreground="#888" VerticalAlignment="Center"/></Grid>
                  </Button>
                  <Button Classes="setting-card" Tag="Interface Settings" Click="SettingsSection_Click">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Interface Settings" FontSize="16" Foreground="White"/><TextBlock Text="Customise the appearance and behavior of the interface" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="28" Foreground="#888" VerticalAlignment="Center"/></Grid>
                  </Button>
                  <Button Classes="setting-card" Tag="Other Settings" Click="SettingsSection_Click">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Other Settings" FontSize="16" Foreground="White"/><TextBlock Text="Additional configuration options and preferences" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="28" Foreground="#888" VerticalAlignment="Center"/></Grid>
                  </Button>
                  <Border Classes="card" Padding="16" MinHeight="80"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Restart Tutorial" FontSize="16" Foreground="White"/><TextBlock Text="Start the guided tour of Zenith's interface again" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><Button Grid.Column="1" Content="Start Tutorial" Background="#0D4AFF" BorderThickness="0"/></Grid></Border>
                  <Border Classes="card" Padding="16" MinHeight="80"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Force Live" FontSize="16" Foreground="White"/><TextBlock Text="Upgrade or downgrade Roblox to the latest LIVE version" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><Button Grid.Column="1" Content="Force Live" Background="#15883C" BorderThickness="0"/></Grid></Border>
                  <Border Classes="card" Padding="16" MinHeight="80"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Official Discord" FontSize="16" Foreground="White"/><TextBlock Text="Join our Discord server for real-time help" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><Button Grid.Column="1" Content="Join Discord"/></Grid></Border>
                  <Border Classes="card" Padding="16" MinHeight="80"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="6"><TextBlock Text="Orion" FontSize="16" Foreground="White"/><TextBlock Text="Return to Orion's interface selection" FontSize="14" Foreground="{StaticResource ZenithMuted}"/></StackPanel><Button Grid.Column="1" Content="Back To Orion" Click="BackToOrion_Click"/></Grid></Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsSectionPage" IsVisible="False" RowDefinitions="55,40,12,*">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                <Button Classes="chrome" Width="38" Height="38" Click="SettingsBack_Click" ToolTip.Tip="Go back to main settings"><TextBlock Text="‹" FontSize="31" Foreground="#999" Margin="0,-4,0,0"/></Button>
                <TextBlock x:Name="SettingsSectionTitle" Text="Execution Settings" FontSize="25" Foreground="White" VerticalAlignment="Center" />
              </StackPanel>
              <Grid Grid.Row="1">
                <TextBox Classes="search" PlaceholderText="Search settings..." />
                <Viewbox Width="18" Height="18" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24"><Path Stroke="#929292" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource ZenithSearchGlyph}" /></Canvas>
                </Viewbox>
              </Grid>
              <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsRowsPanel" Spacing="16" Margin="0,0,8,0" />
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <!-- Original ScriptBlox notice, shown once before the hub is used. -->
      <Border x:Name="ScriptHubNotice" Grid.RowSpan="2" IsVisible="False"
              Background="#D9000000" ZIndex="200">
        <Border Width="672" Padding="24"
                Background="#0A0A0A" BorderBrush="{StaticResource ZenithBorder}"
                BorderThickness="1" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,18,Auto,20,Auto">
            <StackPanel Orientation="Horizontal" Spacing="15">
              <Border Width="46" Height="46" CornerRadius="23" Background="#24FF7940">
                <PathIcon Width="24" Height="24" Foreground="#FF7940"
                          Data="M12,3 L23,21 L1,21 Z M12,9 L12,14 M12,18 L12.01,18" />
              </Border>
              <TextBlock Text="Important Notice" FontSize="20" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="15">
              <TextBlock FontSize="16" Foreground="{StaticResource ZenithSecondary}" TextWrapping="Wrap">
                <Run Text="Scripts in this hub are provided directly from the ScriptBlox website and are " />
                <Run Text="not verified or endorsed" Foreground="#FF7940" />
                <Run Text=" by Zenith. The &quot;Verified&quot; scripts are verified by ScriptBlox, not us." />
              </TextBlock>
              <TextBlock Text="We cannot guarantee the quality, safety, or reliability of these scripts. Some scripts may:"
                         FontSize="16" Foreground="{StaticResource ZenithSecondary}" TextWrapping="Wrap" />
              <TextBlock Text="  •  Not work at all, and simply throw an error&#10;  •  Be incompatible with Zenith&#10;  •  Purposefully cause your game to freeze up or crash&#10;  •  ...Or just generally suck"
                         FontSize="16" LineHeight="28" Foreground="{StaticResource ZenithSecondary}" TextWrapping="Wrap" />
              <TextBlock Text="Always review a script's content before executing it if its possible."
                         FontSize="16" Foreground="{StaticResource ZenithSecondary}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Row="4" Content="I Understand" Click="ScriptHubNoticeDismiss_Click"
                    HorizontalAlignment="Right" Padding="16,9" />
          </Grid>
        </Border>
      </Border>

      <!-- Short native equivalent of Zenith's initialization state. -->
      <Grid x:Name="ZenithLoadingOverlay" Grid.RowSpan="2" Background="#0A0A0A" ZIndex="300" Opacity="1">
        <Grid.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
          </Transitions>
        </Grid.Transitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
          <Ellipse Width="28" Height="28" Stroke="#C0C0C0" StrokeThickness="2"
                   StrokeDashArray="8,4" />
          <TextBlock Text="Initializing..." FontSize="15" Foreground="#7F7F7F" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
