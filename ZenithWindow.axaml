    <StreamGeometry x:Key="ZenithChevronUpGlyph">M6 15L12 9L18 15</StreamGeometry>
    <StreamGeometry x:Key="ZenithPanelTriangleGlyph">M7 5L17 12L7 19Z</StreamGeometry>
