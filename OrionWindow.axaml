              <TextBlock Canvas.Left="8.667" Canvas.Top="13.333"
                         Width="60" Height="10"
                         FontSize="8" Foreground="White"
                         Text="Quick Settings" TextAlignment="Center" />
              <Border Canvas.Left="71.667" Canvas.Top="7.333"
                      Width="0.667" Height="26" Background="#7D7D80" />
              <Border Canvas.Left="78.667" Canvas.Top="8"
                      Width="64.667" Height="22"
                      Background="#07090A" BorderBrush="#252525"
                      BorderThickness="0.667" CornerRadius="2">
                <TextBlock x:Name="OrionTopMostText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="8" Foreground="#FF4C4C" Text="TopMost" />
              </Border>
              <Button Canvas.Left="78.667" Canvas.Top="8"
                      Width="64.667" Height="22"
                      Classes="orion-card-hit"
                      Click="OrionTopMost_Click" />
              <TextBlock Canvas.Left="151.333" Canvas.Top="7.333"
                         Width="16" Height="22"
                         FontSize="15" Foreground="#BCBCBC"
                         Text="+" TextAlignment="Center" />
            </Canvas>
          </Border>
        </Canvas>

        <!-- UI Selection: exact 2/3 conversion of Figma frame 78:303. -->
        <Canvas x:Name="OrionUiSelectionPage"
                Width="664" Height="413.333"
                IsVisible="False" IsHitTestVisible="False" Opacity="0">
          <Border Canvas.Left="7.333" Canvas.Top="54"
                  Width="648.667" Height="352"
                  Background="{StaticResource OrionPageSurface}"
                  BorderBrush="#303235" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True" />

          <TextBlock Canvas.Left="52.667" Canvas.Top="77.333"
                     Width="115" Height="18"
                     FontSize="13.333" Foreground="White"
                     Text="UI Selection" />
          <TextBlock Canvas.Left="52.667" Canvas.Top="97.333"
                     Width="320" Height="10"
                     FontSize="6.667" Foreground="#55585B"
                     Text="Choose an interface. Scroll to browse the full collection." />
          <TextBlock Canvas.Left="62.667" Canvas.Top="122"
                     Width="538" Height="12"
                     FontSize="8" Foreground="#4C4C4C"
                     Text="Synapse: Framework - native" />
          <TextBlock Canvas.Left="62.667" Canvas.Top="235.333"
                     Width="538" Height="12"
                     FontSize="8" Foreground="#4C4C4C"
                     Text="Other UIs" />
          <TextBlock Canvas.Left="504.667" Canvas.Top="85.333"
                     Width="96" Height="12"
                     FontSize="8" Foreground="#4C4C4C"
                     Text="Back To Settings - Home" />
          <Button Canvas.Left="500" Canvas.Top="80" Width="106" Height="22"
                  Classes="orion-card-hit" Click="OrionSettingsNavigation_Click" />

          <!-- Synapse V3 -->
          <Border Canvas.Left="62.667" Canvas.Top="137.333"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-v3.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="Synapse V3" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="62.667" Canvas.Top="137.333" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="SynapseV3" Click="OrionUiChoice_Click" />

          <!-- Synapse 2016-19 -->
          <Border Canvas.Left="199.613" Canvas.Top="137.333"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-2016-19.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="Synapse 2016-19" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="199.613" Canvas.Top="137.333" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="Synapse2017" Click="OrionUiChoice_Click" />

          <!-- Synapse Blue -->
          <Border Canvas.Left="336.56" Canvas.Top="137.333"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-blue.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="Synapse Blue" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="336.56" Canvas.Top="137.333" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="SynapseBlue" Click="OrionUiChoice_Click" />

          <!-- Synapse X -->
          <Border Canvas.Left="473.333" Canvas.Top="137.333"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-x.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="Synapse X" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="473.333" Canvas.Top="137.333" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="SynapseX" Click="OrionUiChoice_Click" />

          <Border Canvas.Left="58" Canvas.Top="220.667"
                  Width="548" Height="0.667" Background="#4C4C4C" />

          <!-- RC7 -->
          <Border Canvas.Left="62.667" Canvas.Top="258"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/rc7.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="RC7" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="62.667" Canvas.Top="258" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="RC7" Click="OrionUiChoice_Click" />

          <!-- KRNL -->
          <Border Canvas.Left="199.333" Canvas.Top="258"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/krnl.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="KRNL" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="199.333" Canvas.Top="258" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="Krnl" Click="OrionUiChoice_Click" />

          <!-- Calamari -->
          <Border Canvas.Left="336.667" Canvas.Top="258"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/calamari.png"
                     Stretch="UniformToFill" Opacity="0.26"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="Calamari" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="336.667" Canvas.Top="258" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="Calamari" Click="OrionUiChoice_Click" />

          <!--
            TEMPORARILY UNUSED — Add Your Own card data retained for later:
            label="Add Your Own." tag="AddYourOwn"
            asset="Assets/Orion/UiSelection/add-your-own.png"
            bounds="473.333,258,127.437,72.753"

            AWP uses the same polished placeholder until a dedicated AWP card
            capture is supplied.
          -->
          <Border Canvas.Left="473.333" Canvas.Top="258"
                  Width="127.437" Height="72.753"
                  BorderBrush="#7D7D80" BorderThickness="0.333"
                  CornerRadius="10" ClipToBounds="True">
            <Grid>
              <Image Source="avares://Orion/Assets/Orion/UiSelection/add-your-own.png"
                     Stretch="UniformToFill" Opacity="0.10"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Height="12.363" VerticalAlignment="Bottom"
                      Background="#3308090A" BorderBrush="#7D7D80"
                      BorderThickness="0.333" CornerRadius="0,0,10,10">
                <TextBlock Text="AWP" FontSize="6" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <Button Canvas.Left="473.333" Canvas.Top="258" Width="127.437" Height="72.753"
                  Classes="orion-card-hit" Tag="AWP" Click="OrionUiChoice_Click" />

          <!-- Scrollable collection overlay. The original Figma-positioned
               cards above remain as design reference data, while this surface
               is the scalable selector used by Orion at runtime. -->
          <Border Canvas.Left="51.333" Canvas.Top="114"
                  Width="561.333" Height="270"
                  Background="#F207080A"
                  BorderBrush="#25282B" BorderThickness="0.667"
                  CornerRadius="10" ClipToBounds="True" Padding="10,8,5,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="7" Margin="0,0,5,2">
                <TextBlock FontSize="8" Foreground="#66696C"
                           Text="Synapse: Framework - native" />
                <WrapPanel>
                  <Button Classes="orion-ui-card" Tag="SynapseV3"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-v3.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="Synapse V3" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Classes="orion-ui-card" Tag="Synapse2017"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-2016-19.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="Synapse 2016-19" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Classes="orion-ui-card" Tag="SynapseBlue"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-blue.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="Synapse Blue" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Classes="orion-ui-card" Tag="SynapseX"
                          Click="OrionUiChoice_Click" Margin="0,0,0,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/synapse-x.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="Synapse X" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                </WrapPanel>

                <Border Height="0.667" Background="#383B3E" Margin="0,0,3,0" />
                <TextBlock FontSize="8" Foreground="#66696C" Text="Other UIs" />
                <WrapPanel>
                  <Button Classes="orion-ui-card" Tag="RC7"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/rc7.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="RC7" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Classes="orion-ui-card" Tag="Krnl"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/krnl.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="KRNL" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Classes="orion-ui-card" Tag="Calamari"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/calamari.png"
                             Stretch="UniformToFill" Opacity="0.26"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="Calamari" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <Button Classes="orion-ui-card" Tag="AWP"
                          Click="OrionUiChoice_Click" Margin="0,0,0,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/add-your-own.png"
                             Stretch="UniformToFill" Opacity="0.10"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="AWP" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                  <!-- Xeno temporarily shares AWP's placeholder artwork. -->
                  <Button Classes="orion-ui-card" Tag="Xeno"
                          Click="OrionUiChoice_Click" Margin="0,0,7,8">
                    <Grid>
                      <Image Source="avares://Orion/Assets/Orion/UiSelection/add-your-own.png"
                             Stretch="UniformToFill" Opacity="0.10"
                             RenderOptions.BitmapInterpolationMode="HighQuality" />
                      <Border Height="12.363" VerticalAlignment="Bottom"
                              Background="#C708090A" BorderBrush="#66696C"
                              BorderThickness="0.333" CornerRadius="0,0,10,10">
                        <TextBlock Text="Xeno" FontSize="6" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Canvas>
        </Canvas>
      </Viewbox>

      <!-- NativeWebView is kept outside the scaled design canvas so its HWND
           remains pixel-sharp and editable. These values are the exact 1.35x
           Monaco rectangle with a half-stroke inset on every side. -->
      <NativeWebView x:Name="OrionMonacoWebView"
                     Width="673.2"
                     Height="380.7"
                     Margin="10.8,120.6,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Background="#08090A"
                     IsVisible="False" />

      <Grid x:Name="LoadingLayer"
            Background="{StaticResource OrionLoadingFill}">
        <Image x:Name="SpinnerMark"
               Width="70"
               Height="70"
               Stretch="Uniform"
               Opacity="0"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               RenderTransformOrigin="50%,50%"
               Source="avares://Orion/Assets/Orion/Sharp/loading-mark.png">
          <Image.RenderTransform>
            <RotateTransform Angle="0" />
          </Image.RenderTransform>
        </Image>
      </Grid>

      <Border x:Name="EdgeStroke"
              BorderBrush="{StaticResource OrionEdgeStroke}"
              BorderThickness="1"
              CornerRadius="15"
              IsHitTestVisible="False" />

    </Grid>
  </Border>
</Window>
