<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OrbitAvalonia.OrionWindow"
        Title="Orion"
        Icon="/Assets/Orion/Sharp/orion-app.ico"
        Width="108"
        Height="108"
        MinWidth="108"
        MinHeight="108"
        CanResize="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="False"
        FontFamily="avares://Orion/Assets/Orion/Fonts#Manrope"
        FontWeight="Bold">

  <Window.Resources>
    <LinearGradientBrush x:Key="OrionWindowFill"
                         StartPoint="0.189114%,-0.48156%"
                         EndPoint="99.810886%,100.48156%">
      <GradientStop Color="#181A1B" Offset="0" />
      <GradientStop Color="#08090A" Offset="0.37019" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrionLoadingFill"
                         StartPoint="-10.3312%,26.3073%"
                         EndPoint="110.3312%,73.6927%">
      <GradientStop Color="#181A1B" Offset="0" />
      <GradientStop Color="#08090A" Offset="0.37019" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrionPageSurface"
                         StartPoint="97.1834%,107.8071%"
                         EndPoint="2.8166%,-7.8071%">
      <GradientStop Color="#00070809" Offset="0" />
      <GradientStop Color="#00111314" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OrionMonacoSurface" Color="#101112" Opacity="0" />
    <SolidColorBrush x:Key="OrionTabSurface" Color="#0E1011" Opacity="0.58" />
    <SolidColorBrush x:Key="OrionUtilityGlass" Color="#07080A" Opacity="0.7" />
    <LinearGradientBrush x:Key="OrionEdgeStroke"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%">
      <GradientStop Color="#7A7E81" Offset="0" />
      <GradientStop Color="#5D6063" Offset="0.38" />
      <GradientStop Color="#303235" Offset="1" />
    </LinearGradientBrush>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.orion-window-button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.orion-window-button:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.orion-action-hit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.orion-card-hit">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.orion-ui-card">
      <Setter Property="Width" Value="127.437" />
      <Setter Property="Height" Value="72.753" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#07080A" />
      <Setter Property="BorderBrush" Value="#66696C" />
      <Setter Property="BorderThickness" Value="0.667" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.orion-ui-card:pointerover">
      <Setter Property="Background" Value="#0D0F11" />
      <Setter Property="BorderBrush" Value="#A2A5A8" />
    </Style>
  </Window.Styles>

  <Border x:Name="RootShell"
          BorderBrush="{StaticResource OrionEdgeStroke}"
          BorderThickness="1"
          CornerRadius="15"
          ClipToBounds="True"
          Background="{StaticResource OrionWindowFill}">

    <Grid x:Name="SurfaceRoot"
          Margin="-1"
          Background="{StaticResource OrionWindowFill}">
      <!-- The authored 2/3 Figma coordinate plane is enlarged as one unit. This
           preserves every relative measurement while producing the requested
           35% larger 896.4 x 558 editor. -->
      <Viewbox x:Name="EditorLayer"
               Width="896.4"
               Height="558"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               Stretch="Fill"
               Opacity="1"
               IsHitTestVisible="False">
        <Canvas Width="664" Height="413.333">
        <Border Canvas.Left="0"
                Canvas.Top="0"
                Width="664"
                Height="53.333"
                Background="Transparent"
                PointerPressed="TitleBar_PointerPressed" />

        <Image Canvas.Left="10.667"
               Canvas.Top="10"
               Width="71"
               Height="24"
               Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="avares://Orion/Assets/Orion/Sharp/wordmark.png" />

        <Button Canvas.Left="562.667" Canvas.Top="12" Width="26" Height="24.667"
                Classes="orion-window-button" Click="Minimize_Click">
          <Image Width="10" Height="2" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/minimize.png" />
        </Button>
        <Button Canvas.Left="594" Canvas.Top="12" Width="26" Height="24.667"
                Classes="orion-window-button" Click="Maximize_Click">
          <Image Width="10" Height="10" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/maximize.png" />
        </Button>
        <Button Canvas.Left="625.333" Canvas.Top="12" Width="26" Height="24.667"
                Classes="orion-window-button" Click="Close_Click">
          <Image Width="10" Height="10" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/close.png" />
        </Button>

        <!-- Exact Figma navigation export (355 x 57 at the authored size).
             Orion's design plane scales it uniformly to the current 0.9 UI. -->
        <Image x:Name="OrionNavigationPanel"
               ZIndex="200"
               Canvas.Left="213.333"
               Canvas.Top="0"
               Width="236.667"
               Height="38"
               Opacity="0"
               IsVisible="False"
               IsHitTestVisible="False"
               Stretch="Fill"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="avares://Orion/Assets/Orion/Nav/navigation-open-dynamic.png">
          <Image.RenderTransform>
            <TranslateTransform Y="-38" />
          </Image.RenderTransform>
        </Image>

        <!-- The page indicator is deliberately separate from the exported
             navigation artwork so it can glide between all five routes. -->
        <Canvas x:Name="OrionNavigationIndicatorHost"
                ZIndex="205"
                Width="664" Height="38"
                Opacity="0"
                IsVisible="False"
                IsHitTestVisible="False">
          <Canvas.RenderTransform>
            <TranslateTransform Y="-38" />
          </Canvas.RenderTransform>
          <Border x:Name="OrionNavigationIndicator"
                  Canvas.Left="324"
                  Canvas.Top="27.333"
                  Width="16.667"
                  Height="1.333"
                  Background="White"
                  CornerRadius="1" />
        </Canvas>

        <!-- The same exported arrow is rotated and translated between the
             exact closed and open positions from frames 76:63 and 74:48. -->
        <Image x:Name="OrionNavigationArrow"
               ZIndex="202"
               Canvas.Left="328.708"
               Canvas.Top="3.292"
               Width="6.75"
               Height="13.5"
               Stretch="Fill"
               RenderTransformOrigin="50%,50%"
               IsHitTestVisible="False"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Source="avares://Orion/Assets/Orion/Nav/navigation-arrow.png">
          <Image.RenderTransform>
            <TransformGroup>
              <RotateTransform Angle="90" />
              <TranslateTransform Y="0" />
            </TransformGroup>
          </Image.RenderTransform>
        </Image>

        <!-- Deliberately compact while closed; this avoids opening the tray
             from ordinary movement through the upper quarter of the window. -->
        <Border x:Name="OrionNavigationTrigger"
                ZIndex="203"
                Canvas.Left="312.083"
                Canvas.Top="0"
                Width="40"
                Height="18.5"
                Background="Transparent"
                Cursor="Hand"
                PointerEntered="OrionNavigationTrigger_PointerEntered"
                PointerExited="OrionNavigationTrigger_PointerExited" />

        <!-- When open, retain a small buffer around the panel and moving arrow
             so crossing the authored edge does not make navigation twitch. -->
        <Border x:Name="OrionNavigationOpenHoverArea"
                ZIndex="201"
                Canvas.Left="205.333"
                Canvas.Top="0"
                Width="252.667"
                Height="58"
                Background="Transparent"
                IsVisible="False"
                IsHitTestVisible="False"
                PointerEntered="OrionNavigationOpenArea_PointerEntered"
                PointerExited="OrionNavigationOpenArea_PointerExited" />

        <!-- The navigation icons retain the exact exported appearance. These
             transparent hit targets add routing without hover/selection boxes. -->
        <Canvas x:Name="OrionNavigationButtons"
                ZIndex="204"
                Width="664" Height="38"
                IsHitTestVisible="False">
        <Button Canvas.Left="225.333" Canvas.Top="3.333" Width="38" Height="28"
                Classes="orion-card-hit"
                PointerEntered="OrionNavigationButton_PointerEntered"
                PointerExited="OrionNavigationButton_PointerExited"
                Click="OrionPluginsNavigation_Click" />
        <Button Canvas.Left="269.333" Canvas.Top="3.333" Width="38" Height="28"
                Classes="orion-card-hit"
                PointerEntered="OrionNavigationButton_PointerEntered"
                PointerExited="OrionNavigationButton_PointerExited"
                Click="OrionSettingsNavigation_Click" />
        <Button Canvas.Left="313.333" Canvas.Top="3.333" Width="38" Height="28"
                Classes="orion-card-hit"
                PointerEntered="OrionNavigationButton_PointerEntered"
                PointerExited="OrionNavigationButton_PointerExited"
                Click="OrionEditorNavigation_Click" />
        <Button Canvas.Left="357.333" Canvas.Top="3.333" Width="38" Height="28"
                Classes="orion-card-hit"
                PointerEntered="OrionNavigationButton_PointerEntered"
                PointerExited="OrionNavigationButton_PointerExited"
                Click="OrionThemesNavigation_Click" />
        <Button Canvas.Left="401.333" Canvas.Top="3.333" Width="38" Height="28"
                Classes="orion-card-hit"
                PointerEntered="OrionNavigationButton_PointerEntered"
                PointerExited="OrionNavigationButton_PointerExited"
                Click="OrionScriptHubNavigation_Click" />
        </Canvas>

        <Canvas x:Name="OrionEditorPage" Width="664" Height="413.333">
        <Border Canvas.Left="7.333"
                Canvas.Top="53.333"
                Width="648.667"
                Height="352"
                Background="{StaticResource OrionPageSurface}"
                BorderBrush="#303235"
                BorderThickness="0.667"
                CornerRadius="10"
                ClipToBounds="True" />

        <Border Canvas.Left="7.333"
                Canvas.Top="88.667"
                Width="500"
                Height="283.333"
                Background="{StaticResource OrionMonacoSurface}"
                BorderBrush="#303235"
                BorderThickness="0.667" />

        <!-- Exact console proportions from the supplied frame 114:300
             captures: a tab above the output surface and a clear control
             tucked into its upper-right edge. -->
        <Border x:Name="OrionConsolePanel"
                ZIndex="20"
                Canvas.Left="7.333"
                Canvas.Top="229.333"
                Width="500"
                Height="142.827"
                Background="Transparent"
                BorderThickness="0"
                ClipToBounds="True"
                IsVisible="False"
                IsHitTestVisible="False"
                Opacity="0">
          <Canvas Width="500" Height="142.827">
            <Border Canvas.Left="0" Canvas.Top="18.333"
                    Width="500" Height="124.494"
                    Background="#B307080A"
                    BorderBrush="#303235"
                    BorderThickness="0.667" />

            <Border Canvas.Left="0" Canvas.Top="0"
                    Width="66.667" Height="18.667"
                    Background="#D907080A"
                    BorderBrush="#303235"
                    BorderThickness="0.667"
                    CornerRadius="4.667,4.667,0,0">
              <Grid ColumnDefinitions="23.333,*">
                <Path Width="8" Height="8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Fill="#7D7D80"
                      Data="M92.4391 31.8836C92.1918 31.8836 91.9847 31.8004 91.8177 31.6339C91.6508 31.4674 91.567 31.2616 91.5664 31.0165C91.5658 30.7715 91.6496 30.5657 91.8177 30.3992C91.9859 30.2327 92.193 30.1495 92.4391 30.1495H97.675C97.9223 30.1495 98.1297 30.2327 98.2972 30.3992C98.4648 30.5657 98.5483 30.7715 98.5477 31.0165C98.5471 31.2616 98.4633 31.4677 98.2964 31.6348C98.1294 31.8018 97.9223 31.8848 97.675 31.8836H92.4391ZM88.6648 23.213L85.2833 19.8531C85.1088 19.6797 85.0215 19.4739 85.0215 19.2358C85.0215 18.9976 85.1088 18.7915 85.2833 18.6175C85.4578 18.4436 85.6614 18.3568 85.8941 18.3574C86.1269 18.358 86.3305 18.4447 86.505 18.6175L90.5192 22.606C90.6938 22.7794 90.781 22.9818 90.781 23.213C90.781 23.4442 90.6938 23.6465 90.5192 23.8199L86.505 27.8084C86.3305 27.9818 86.1269 28.0685 85.8941 28.0685C85.6614 28.0685 85.4578 27.9818 85.2833 27.8084C85.1088 27.635 85.0215 27.4292 85.0215 27.1911C85.0215 26.9529 85.1088 26.7468 85.2833 26.5728L88.6648 23.213Z" />
                <TextBlock Grid.Column="1"
                           Margin="6.667,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="8.667"
                           Foreground="#7D7D80"
                           Text="console" />
              </Grid>
            </Border>

            <Border Canvas.Left="433.333" Canvas.Top="18.333"
                    Width="66.667" Height="18.667"
                    Background="#D907080A"
                    BorderBrush="#303235"
                    BorderThickness="0.667"
                    CornerRadius="0,0,0,4.667">
              <Grid ColumnDefinitions="25.333,*">
                <Image Width="9.333" Height="9.333"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Stretch="Uniform"
                       Source="avares://Orion/Assets/Orion/Sharp/clear.png" />
                <TextBlock Grid.Column="1"
                           Margin="5.333,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="8.667"
                           Foreground="#7D7D80"
                           Text="clear" />
              </Grid>
            </Border>

            <Button Canvas.Left="433.333" Canvas.Top="18.333"
                    Width="66.667" Height="18.667"
                    Classes="orion-action-hit"
                    Click="OrionConsoleClear_Click" />

            <ScrollViewer Canvas.Left="12" Canvas.Top="42"
                          Width="414" Height="94"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="OrionConsoleOutput" Spacing="5.333" />
            </ScrollViewer>
          </Canvas>
        </Border>

        <Canvas x:Name="OrionTabsCanvas"
                Canvas.Left="14.667"
                Canvas.Top="59.333"
                Width="485"
                Height="28.985" />

        <Border x:Name="OrionExecuteVisual" Canvas.Left="15.333" Canvas.Top="378" Width="79.268" Height="21.619"
                Background="#07080A" BorderBrush="#525558" BorderThickness="0.667" CornerRadius="4.667">
          <Canvas Width="79.268" Height="21.619">
            <Image Canvas.Left="10.433" Canvas.Top="5.633" Width="11" Height="11" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/execute.png" />
            <TextBlock Canvas.Left="25.62" Canvas.Top="4.133" Width="44.04" Height="13.333"
                       FontFamily="avares://Orion/Assets/Orion/Fonts#Manrope"
                       FontSize="9.333" FontWeight="Bold" Foreground="#7D7D80"
                       Text="execute" TextAlignment="Center" />
          </Canvas>
        </Border>
        <Button x:Name="OrionExecuteButton"
                Canvas.Left="15.333" Canvas.Top="378" Width="79.268" Height="21.619"
                Classes="orion-action-hit" Click="OrionExecute_Click" />

        <Border Canvas.Left="101.007" Canvas.Top="378" Width="79.268" Height="21.619"
                Background="#07080A" BorderBrush="#525558" BorderThickness="0.667" CornerRadius="4.667">
          <Canvas Width="79.268" Height="21.619">
            <Image Canvas.Left="10.413" Canvas.Top="5.633" Width="11" Height="11" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/save-file.png" />
            <TextBlock Canvas.Left="25.62" Canvas.Top="4.133" Width="44.04" Height="13.333"
                       FontFamily="avares://Orion/Assets/Orion/Fonts#Manrope"
                       FontSize="9.333" FontWeight="Bold" Foreground="#7D7D80"
                       Text="save file" TextAlignment="Center" />
          </Canvas>
        </Border>
        <Button Canvas.Left="101.007" Canvas.Top="378" Width="79.268" Height="21.619"
                Classes="orion-action-hit" Click="OrionSave_Click" />

        <Border Canvas.Left="186.68" Canvas.Top="378" Width="79.268" Height="21.619"
                Background="#07080A" BorderBrush="#525558" BorderThickness="0.667" CornerRadius="4.667">
          <Canvas Width="79.268" Height="21.619">
            <Image Canvas.Left="8.787" Canvas.Top="5.633" Width="11" Height="11" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/open-file.png" />
            <TextBlock Canvas.Left="23.993" Canvas.Top="4.133" Width="46.44" Height="13.333"
                       FontFamily="avares://Orion/Assets/Orion/Fonts#Manrope"
                       FontSize="9.333" FontWeight="Bold" Foreground="#7D7D80"
                       Text="open file" TextAlignment="Center" />
          </Canvas>
        </Border>
        <Button Canvas.Left="186.68" Canvas.Top="378" Width="79.268" Height="21.619"
                Classes="orion-action-hit" Click="OrionOpen_Click" />

        <Border Canvas.Left="272.353" Canvas.Top="378" Width="53.646" Height="21.619"
                Background="#07080A" BorderBrush="#525558" BorderThickness="0.667" CornerRadius="4.667">
          <Canvas Width="53.646" Height="21.619">
            <Image Canvas.Left="6.393" Canvas.Top="5.633" Width="11" Height="11" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/clear.png" />
            <TextBlock Canvas.Left="20.82" Canvas.Top="4.133" Width="27.227" Height="13.333"
                       FontFamily="avares://Orion/Assets/Orion/Fonts#Manrope"
                       FontSize="9.333" FontWeight="Bold" Foreground="#7D7D80"
                       Text="clear" TextAlignment="Center" />
          </Canvas>
        </Border>
        <Button Canvas.Left="272.353" Canvas.Top="378" Width="53.646" Height="21.619"
                Classes="orion-action-hit"
                PointerPressed="OrionClear_PointerPressed"
                Click="OrionClear_Click" />

        <TextBlock x:Name="OrionCursorPositionText"
                   Canvas.Left="399.333"
                   Canvas.Top="383.333"
                   Width="100"
                   Height="11.333"
                   FontSize="8.667"
                   Foreground="#A9A9AB"
                   TextAlignment="Right"
                   Text="Ln (num), Col (num)" />

        <Border Canvas.Left="507.333" Canvas.Top="53.333" Width="148.667" Height="35.333"
                Background="{StaticResource OrionUtilityGlass}" BorderBrush="#303235" BorderThickness="0.667"
                CornerRadius="0,10,0,0" />
        <Border Canvas.Left="507.333" Canvas.Top="88.667" Width="148.788" Height="283.493"
                Background="{StaticResource OrionUtilityGlass}" BorderBrush="#303235" BorderThickness="0.667" />

        <Image Canvas.Left="528.28" Canvas.Top="65.347"
               Width="11" Height="11" Stretch="Uniform"
               Source="avares://Orion/Assets/Orion/Sharp/search.png" />
        <TextBlock Canvas.Left="544.667" Canvas.Top="65.333" FontSize="8.667"
                   Foreground="#454747" Text="Search Script List..." />

        <Border Canvas.Left="512" Canvas.Top="94" Width="140" Height="23.767"
                Background="#07080A" BorderBrush="#303235" BorderThickness="0.667" CornerRadius="3.333">
          <Canvas Width="140" Height="23.767">
            <Image Canvas.Left="6" Canvas.Top="7.2" Width="7.333" Height="9.333" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/script-row-action.png" />
            <TextBlock Canvas.Left="28" Canvas.Top="6.133" Width="86.667" FontSize="8.667"
                       Foreground="#454747" Text="Local Filesystem" TextAlignment="Center" />
          </Canvas>
        </Border>

        <Border Canvas.Left="512" Canvas.Top="123.333" Width="140" Height="23.767"
                Background="#07080A" BorderBrush="#303235" BorderThickness="0.667" CornerRadius="3.333">
          <Canvas Width="140" Height="23.767">
            <Image Canvas.Left="5.333" Canvas.Top="7.933" Width="9" Height="8" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/autoexecute.png" />
            <TextBlock Canvas.Left="28" Canvas.Top="6.133" Width="86.667" FontSize="8.667"
                       Foreground="#454747" Text="Auto Execute Sync" TextAlignment="Center" />
          </Canvas>
        </Border>

        <Border Canvas.Left="512" Canvas.Top="152.667" Width="140" Height="23.767"
                Background="#07080A" BorderBrush="#303235" BorderThickness="0.667" CornerRadius="3.333">
          <Canvas Width="140" Height="23.767">
            <Image Canvas.Left="5.333" Canvas.Top="7.933" Width="9" Height="9" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/github.png" />
            <TextBlock Canvas.Left="28" Canvas.Top="6.133" Width="86.667" FontSize="8.667"
                       Foreground="#454747" Text="Github Gists" TextAlignment="Center" />
          </Canvas>
        </Border>

        <Border Canvas.Left="512" Canvas.Top="182" Width="140" Height="23.767"
                Background="#07080A" BorderBrush="#303235" BorderThickness="0.667" CornerRadius="3.333">
          <Canvas Width="140" Height="23.767">
            <Image Canvas.Left="6.667" Canvas.Top="7.933" Width="7" Height="9" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/bookmark.png" />
            <TextBlock Canvas.Left="28" Canvas.Top="6.133" Width="86.667" FontSize="8.667"
                       Foreground="#454747" Text="Bookmarks" TextAlignment="Center" />
          </Canvas>
        </Border>

        <Border Canvas.Left="512" Canvas.Top="211.333" Width="140" Height="23.767"
                Background="#07080A" BorderBrush="#303235" BorderThickness="0.667" CornerRadius="3.333,3.333,0,0">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="8.667" Foreground="#454747" Text="Opened Section Example" />
        </Border>
        <Border Canvas.Left="512" Canvas.Top="238" Width="140" Height="91.333"
                Background="#07080A" BorderBrush="#303235" BorderThickness="0.667" CornerRadius="0,0,3.333,3.333">
          <Canvas Width="140" Height="91.333">
            <Image Canvas.Left="16.667" Canvas.Top="4.667" Width="9" Height="9" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/script-list-dot.png" />
            <TextBlock Canvas.Left="31.333" Canvas.Top="3.333" FontSize="6.667" Foreground="#7D7D80" Text="Script" />
            <Image Canvas.Left="56.667" Canvas.Top="4.667" Width="5" Height="5" Stretch="Uniform" Source="avares://Orion/Assets/Orion/Sharp/row-bookmark.png" />
